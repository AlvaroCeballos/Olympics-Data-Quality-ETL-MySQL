# Configuración de conexiones Fase 3
# Copiar este archivo como .env en la carpeta Fase3/ y completar los valores

# MySQL (Fase 1)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=admin
MYSQL_DB=olimpiadas

# MongoDB Atlas
# Formato: mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=Olimpiadas
MONGO_URI=mongodb+srv://USUARIO:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority&appName=Olimpiadas
MONGO_DB=olimpiadas
